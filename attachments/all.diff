+      if (!res.ok) { setErr(L(lang, `No ${seat.dept} card number ${raw.trim().padStart(2, "0")}. Check the number on the card.`, `No hay carta de ${deptLabel(seat.dept, "es")} número ${raw.trim().padStart(2, "0")}. Revisa el número.`)); return; }
