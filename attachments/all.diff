+        <>
+          <button type="button" className="grid w-full grid-cols-3 gap-1" onClick={() => setCarousel(true)} aria-label={L(lang, "Open your cards", "Abrir tus cartas")}>
+            {draw.cards.map((card) => {
+              const face = cardFace(card);
